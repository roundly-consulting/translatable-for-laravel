includes:
    - vendor/larastan/larastan/extension.neon
    - extension.neon
parameters:
    level: 7
    paths:
        - src
        - config
        # The consumer-facing traits are only applied by host models, so include the
        # test fixtures that use them so PHPStan analyses the traits in context.
        - tests/Fixtures/Topic.php
        - tests/Fixtures/StrictTopic.php
        - tests/Fixtures/EventfulTopic.php
        - tests/Fixtures/SluggedTopic.php
        - tests/Fixtures/LooseFallbackTopic.php
        - tests/Fixtures/UninitialisedFallbackTopic.php
        # A host migration calling the schema macro: proves it is declared for Larastan.
        - tests/PHPStan
    # This package ships its own config/ dir; env() is correct there.
    configDirectories:
        - config
